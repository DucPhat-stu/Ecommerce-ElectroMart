# ============================================
# ElectroMart API - Docker Environment Configuration
# ============================================
# This file contains environment variables for Docker Compose
# Use this when running: docker-compose up

# ============================================
# DATABASE CONFIGURATION (Docker)
# ============================================
# MySQL Database (running in container, connected via service name 'db')
DB_HOST=db
DB_PORT=3306
DB_NAME=ElectroStore
DB_USERNAME=user
DB_PASSWORD=123123
DB_DRIVER=com.mysql.cj.jdbc.Driver

# MySQL Root Password (for Docker MySQL service)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ElectroStore
MYSQL_USER=user
MYSQL_PASSWORD=123123

# ============================================
# SPRING BOOT CONFIGURATION (Docker)
# ============================================
# Application name and port
SPRING_APPLICATION_NAME=electro
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# Database Connection (Docker - connect via service name 'db')
SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/ElectroStore?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=123123
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_JDBC_BATCH_SIZE=20
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_INSERTS=true
SPRING_JPA_PROPERTIES_HIBERNATE_ORDER_UPDATES=true

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_STORE_ELECTRO=INFO
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=INFO

# ============================================
# JWT CONFIGURATION (Docker)
# ============================================
# JWT Secret Key (256-bit minimum for HS256)
# For production deployment: MUST change this value!
APP_JWT_SECRET=docker-production-secret-key-min-256-bits-for-hs256-algorithm-must-be-changed-in-production

# JWT Expiration Time (in milliseconds)
# Default: 86400000 ms = 24 hours
APP_JWT_EXPIRATION=86400000

# ============================================
# SECURITY CONFIGURATION (Docker)
# ============================================
# CORS Settings (Docker environment)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://nginx
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Forwarded-For
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================
# API CONFIGURATION (Docker)
# ============================================
# API Version
API_VERSION=v1

# Request/Response Configuration
SERVER_TOMCAT_MAX_HTTP_POST_SIZE=10485760
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=8192

# Nginx Configuration
NGINX_HOST=nginx
NGINX_PORT=80

# ============================================
# PROFILE
# ============================================
# Spring Profile (dev, staging, prod)
# For Docker: use 'docker' profile
SPRING_PROFILES_ACTIVE=docker

# ============================================
# DOCKER SERVICE CONFIGURATION
# ============================================
# Service names for container communication
DB_SERVICE_NAME=db
BACKEND_SERVICE_NAME=backend
NGINX_SERVICE_NAME=nginx-service
NETWORK_NAME=app-network

# Container restart policy
RESTART_POLICY=unless-stopped
