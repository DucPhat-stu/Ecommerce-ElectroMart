# ============================================
# ElectroMart API - Local Development Environment
# ============================================
# This file contains environment variables for local development
# Copy this to .env.local for local testing without affecting the main .env

# ============================================
# DATABASE CONFIGURATION (Local)
# ============================================
# MySQL Database (running on localhost:3306)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ElectroStore
DB_USERNAME=user
DB_PASSWORD=123123
DB_DRIVER=com.mysql.cj.jdbc.Driver

# ============================================
# SPRING BOOT CONFIGURATION
# ============================================
# Application name and port
SPRING_APPLICATION_NAME=electro
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/api/v1

# JPA/Hibernate Configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# Logging Configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_STORE_ELECTRO=DEBUG
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG

# ============================================
# JWT CONFIGURATION
# ============================================
# JWT Secret Key (256-bit minimum for HS256)
# For development: using default key
# For production: MUST change to a strong random key
APP_JWT_SECRET=development-secret-key-min-256-bits-for-hs256-algorithm-change-this-in-production-immediately

# JWT Expiration Time (in milliseconds)
# Default: 86400000 ms = 24 hours
APP_JWT_EXPIRATION=86400000

# ============================================
# SECURITY CONFIGURATION
# ============================================
# CORS Settings (for local development)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:80
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# ============================================
# API CONFIGURATION
# ============================================
# API Version
API_VERSION=v1

# Request/Response Configuration
SERVER_TOMCAT_MAX_HTTP_POST_SIZE=10485760
SERVER_MAX_HTTP_REQUEST_HEADER_SIZE=8192

# ============================================
# PROFILE
# ============================================
# Spring Profile (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev
