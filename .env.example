# ==================== ENVIRONMENT VARIABLES ====================
# Copy this file to .env and update the values as needed
# This file provides configuration for local development

# ==================== DATABASE CONFIGURATION ====================
# MySQL Database Connection (for local development without Docker)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/ElectroStore?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=123123

# Hibernate DDL Strategy
# Options: create, create-drop, validate, update, none
# Use 'none' in production - database should be managed by migration scripts
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# Show SQL queries in console (set to false in production)
SPRING_JPA_SHOW_SQL=true

# ==================== SERVER CONFIGURATION ====================
SERVER_PORT=8080

# ==================== JWT CONFIGURATION ====================
# IMPORTANT: Change these values in production!
# Generate a secure random key: openssl rand -base64 32
JWT_SECRET=your-256-bit-secret-key-change-this-in-production-environment-for-security
JWT_EXPIRATION=86400000

# ==================== DOCKER ENVIRONMENT ====================
# These are automatically set by docker-compose.yml
# SPRING_DATASOURCE_URL=jdbc:mysql://db:3306/ElectroStore?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=user
# SPRING_DATASOURCE_PASSWORD=123123
